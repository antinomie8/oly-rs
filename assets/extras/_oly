#compdef oly

autoload -U is-at-least

_oly() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_oly_commands" \
"*::: :->oly" \
&& ret=0
    case $state in
    (oly)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:oly-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-o[Overwrite previous database entry for the problem]' \
'--overwrite[Overwrite previous database entry for the problem]' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(gen)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'--open[Open the generated pdf]' \
'--no-open[Do not open the generated pdf]' \
'--clean[Remove auxiliary files]' \
'--no-pdf[Only generate a source file]' \
'--no-source[Remove the source file and induce --clean]' \
'--cwd[Create the pdf in the current directory]' \
'-p[Print the path of the directory where the pdf will be generated]' \
'--print-path[Print the path of the directory where the pdf will be generated]' \
'--clear-cache[Clear the cache]' \
'--regen[Regenerate the pdf even if it was cached]' \
'--all[Generate a pdf for each solution file]' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::queries:_default' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--color=[When to use terminal colours (always, auto, never)]:COLOR:_default' \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-t[Test whether get_problem_name output matches the source]' \
'--test[Test whether get_problem_name output matches the source]' \
'--print0[Output entries separated by NUL bytes]' \
'--filter-lang[Only output the entries written in the current markup language]' \
'--no-filter-lang[Output entries regardless of the markup language used]' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(alias)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-i[Prompt before deleting file]' \
'--confirm[Prompt before deleting file]' \
'-f[Do not prompt before deleting file]' \
'--force[Do not prompt before deleting file]' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(mv)
_arguments "${_arguments_options[@]}" : \
'-c+[Specify config file to use]:FILE:_files' \
'--config-file=[Specify config file to use]:FILE:_files' \
'--log-level=[Specify log level]:LOG_LEVEL:_default' \
'--lang=[Choose markup language to use]:LANG:_default' \
'--language=[Choose which language to use]:LANGUAGE:_default' \
'--scheme=[Use the scheme handler]::SCHEME:_default' \
'-a[Alias the new file to the old one]' \
'--alias[Alias the new file to the old one]' \
'-v[Print program version and related info]' \
'--version[Print program version and related info]' \
'--verify-config[Check whether the config has any errors]' \
'-h[Print help]' \
'--help[Print help]' \
'*::problems:_oly_problems' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_oly__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:oly-help-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(gen)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(alias)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mv)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_oly_commands] )) ||
_oly_commands() {
    local commands; commands=(
'add:Add a problem to the database' \
'edit:Edit an entry from the database' \
'gen:Generate a pdf for a problem' \
'search:Search problems by contest, metadata...' \
'show:Print a problem statement' \
'list:List problems in the database' \
'alias:Link a problem to another one' \
'rm:Remove a problem and its solution file' \
'mv:Rename a problem' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t subcommand 'subcommand' commands "$@"
}
